<?xml version="1.0"?>
<peripherals xmlns:xi="http://www.w3.org/2001/XInclude">
  <peripheral name="Uart">
    <pin name="Rx">
      <input name="USART:_RX"/>
      <input name="UART:_RX"/>
    </pin>
    <pin name="Tx">
      <input name="USART:_TX"/>
      <input name="UART:_TX"/>
    </pin>
	<pin name="Rts">
      <input name="USART:_RTS"/>
      <input name="UART:_RTS"/>
    </pin>
    <pin name="Cts">
      <input name="USART:_CTS"/>
      <input name="UART:_CTS"/>
    </pin>
  </peripheral>
  <peripheral name="Lpuart">
    <pin name="Rx">
      <input name="LPUART:_RX"/>
    </pin>
    <pin name="Tx">
      <input name="LPUART:_TX"/>
    </pin>
	<pin name="Rts">
      <input name="LPUART:_RTS"/>
    </pin>
    <pin name="Cts">
      <input name="LPUART:_CTS"/>
    </pin>
  </peripheral>
  <peripheral name="Spi">
    <pin name="Clock" speed="High"><input name="SPI:_SCK"/></pin>
    <pin name="Miso" speed="High"><input name="SPI:_MISO"/></pin>
    <pin name="Mosi" speed="High"><input name="SPI:_MOSI"/></pin>
    <pin name="SlaveSelect" speed="High"><input name="SPI:_NSS"/></pin>
  </peripheral>
  <peripheral name="Sai">
    <pin name="Sck" speed="High"><input name="SAI:_SCK_A"/><input name="SAI:_SCK_B"/></pin>
    <pin name="MClock" speed="High"><input name="SAI:_MCLK_A"/><input name="SAI:_MCLK_B"/></pin>
    <pin name="Sd" speed="High"><input name="SAI:_SD_A"/><input name="SAI:_SD_B"/></pin>
    <pin name="Fs" speed="High"><input name="SAI:_FS_A"/><input name="SAI:_FS_B"/></pin>
    <pin name="Ck1" speed="High"><input name="SAI:_CK1"/></pin>
    <pin name="Ck2" speed="High"><input name="SAI:_CK2"/></pin>
    <pin name="D1" speed="High"><input name="SAI:_D1"/></pin>
    <pin name="D2" speed="High"><input name="SAI:_D2"/></pin>
    <pin name="D3" speed="High"><input name="SAI:_D3"/></pin>
  </peripheral>
  <peripheral name="I2s">
    <pin name="Ck" speed="High"><input name="I2S:_CK"/></pin>
    <pin name="Ws" speed="High"><input name="I2S:_WS"/></pin>
    <pin name="MClock" speed="High"><input name="I2S:_MCK"/></pin>
    <!-- H5 and H7 split the data line into SDI and SDO; one type serves both directions -->
    <pin name="Sd" speed="High"><input name="I2S:_SD"/><input name="I2S:_SDI"/><input name="I2S:_SDO"/></pin>
  </peripheral>
  <peripheral name="Sd">
    <pin name="Clk" speed="High"><input name="SDMMC:_CK"/><input name="SDIO_CK"/></pin>
    <pin name="Cmd" speed="High"><input name="SDMMC:_CMD"/><input name="SDIO_CMD"/></pin>
    <pin name="D0" speed="High"><input name="SDMMC:_D0"/><input name="SDIO_D0"/></pin>
    <pin name="D1" speed="High"><input name="SDMMC:_D1"/><input name="SDIO_D1"/></pin>
    <pin name="D2" speed="High"><input name="SDMMC:_D2"/><input name="SDIO_D2"/></pin>
    <pin name="D3" speed="High"><input name="SDMMC:_D3"/><input name="SDIO_D3"/></pin>
    <!-- level shifter direction signals, H5 and H7 only -->
    <pin name="D0Dir" speed="High"><input name="SDMMC:_D0DIR"/></pin>
    <pin name="D123Dir" speed="High"><input name="SDMMC:_D123DIR"/></pin>
    <pin name="CDir" speed="High"><input name="SDMMC:_CDIR"/></pin>
  </peripheral>
  <peripheral name="QuadSpi">
    <pin name="Clock" speed="High"><input name="QUADSPI_CLK"/></pin>
    <pin name="SlaveSelect" speed="High"><input name="QUADSPI_BK1_NCS"/></pin>
    <pin name="Data0" speed="High"><input name="QUADSPI_BK1_IO0"/></pin>
    <pin name="Data1" speed="High"><input name="QUADSPI_BK1_IO1"/></pin>
    <pin name="Data2" speed="High"><input name="QUADSPI_BK1_IO2"/></pin>
    <pin name="Data3" speed="High"><input name="QUADSPI_BK1_IO3"/></pin>
  </peripheral>
  <peripheral name="I2c">
    <pin name="Scl" drive="OpenDrain"><input name="I2C:_SCL"/></pin>
    <pin name="Sda" drive="OpenDrain"><input name="I2C:_SDA"/></pin>
  </peripheral>
